# ─── Pea Ice Cream – Supabase Configuration ──────────────────────────────────
# Salin file ini menjadi .env.local dan isi dengan kredensial proyek Supabase Anda.
# File .env.local diabaikan oleh Git untuk menjaga keamanan rahasia.

# URL Proyek Supabase (Ditemukan di Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anonim Publik (Ditemukan di Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Kunci Rahasia Server Role (Ditemukan di Project Settings > API > service_role)
# PENTING: Kunci ini HANYA digunakan oleh server Next.js (tidak boleh diekspos ke browser / NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret key untuk menandatangani cookie token tamu pesanan (HMAC-SHA256)
# Ganti dengan string acak rahasia yang panjang
GUEST_ORDER_SECRET=ganti-dengan-string-rahasia-acak-minimal-32-karakter
